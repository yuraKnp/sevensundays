{% comment %}
  Full-bleed background image with a heading and a 3-column feature grid.
  One "Content" block per collection (heading + image), and up to 3 "Feature"
  blocks per collection (title + text), matched the same way.
{% endcomment %}

<link rel="stylesheet" href="{{ 'component-category-page.css' | asset_url }}" media="print" onload="this.media='all'">

{%- liquid
  assign content_block = null
  assign features = section.blocks | where: 'type', 'feature'

  for block in section.blocks
    if block.type == 'content' and block.settings.collection == collection
      assign content_block = block
    endif
  endfor
-%}

{%- if content_block -%}
  <div class="cat-section container">
    <div class="cat-band" {{ content_block.shopify_attributes }}>
      {%- if content_block.settings.image != blank -%}
        {{ content_block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '100vw' }}
      {%- endif -%}
      {%- if content_block.settings.heading != blank -%}
        <h2 class="cat-band__heading">{{ content_block.settings.heading }}</h2>
      {%- endif -%}
      <div class="cat-band__grid">
        {%- for block in features -%}
          {%- if block.settings.collection == collection -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}<b>{{ block.settings.title | escape }}</b>{%- endif -%}
              {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Category feature band",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "content",
      "name": "Collection content",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "This content shows only when this collection is the one being viewed."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Which collection's feature band this belongs to."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category feature band",
      "blocks": [{ "type": "content" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
