{% comment %}
  Small trust/delivery icon strip. Same content for every category page using this
  template — plain blocks, no per-collection matching.
{% endcomment %}


{%- if section.blocks.size > 0 -%}
  <div class="cat-delivery container">
    {%- for block in section.blocks -%}
      <div class="cat-delivery__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          {{ block.settings.icon | image_url: width: 52 | image_tag: loading: 'lazy', width: 26, height: 26 }}
        {%- endif -%}
        {{ block.settings.text | escape }}
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Category delivery strip",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category delivery strip",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
