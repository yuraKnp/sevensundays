{% comment %}
  Full-bleed closing CTA on the Shop page ("Unsicher, was zu deinem Körper
  passt?"). Single instance, always shown — no per-collection matching.
{% endcomment %}


{%- if section.settings.heading != blank -%}
  <div class="container">
    <div class="shop-helper">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '100vw' }}
      {%- endif -%}
      <div class="shop-helper__inner">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="shop-helper__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
          <a href="{{ section.settings.button_url }}" class="btn">
            <b>{{ section.settings.button_label | escape }}</b>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Shop closing CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Shop closing CTA"
    }
  ]
}
{% endschema %}
