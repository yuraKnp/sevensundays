{% comment %}
  Full-bleed "need help deciding?" banner. One "Content" block per collection.
{% endcomment %}

<link rel="stylesheet" href="{{ 'component-category-page.css' | asset_url }}" media="print" onload="this.media='all'">

{%- liquid
  assign content_block = null
  for block in section.blocks
    if block.settings.collection == collection
      assign content_block = block
    endif
  endfor
-%}

{%- if content_block -%}
  <div class="cat-section">
    <div class="cat-cta" {{ content_block.shopify_attributes }}>
      {%- if content_block.settings.image != blank -%}
        {{ content_block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '100vw' }}
      {%- endif -%}
      <div class="cat-cta__inner">
        {%- if content_block.settings.heading != blank -%}
          <h2>{{ content_block.settings.heading }}</h2>
        {%- endif -%}
        {%- if content_block.settings.text != blank -%}
          <p>{{ content_block.settings.text }}</p>
        {%- endif -%}
        {%- if content_block.settings.button_label != blank and content_block.settings.button_url != blank -%}
          <a href="{{ content_block.settings.button_url }}" class="btn">
            <b>{{ content_block.settings.button_label | escape }}</b>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Category CTA banner",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "content",
      "name": "Collection content",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "This content shows only when this collection is the one being viewed."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category CTA banner",
      "blocks": [{ "type": "content" }]
    }
  ]
}
{% endschema %}
