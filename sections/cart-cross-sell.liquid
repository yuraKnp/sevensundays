{% comment %}
  "Zusätzliche Angebote" cross-sell strip shown between the cart items and the
  order summary (see S7 MOCKUP FINALS/seven-sundays-warenkorb.html, ".offers").
  Each block is a merchant-picked product added via the same <product-form>
  web component Dawn uses on product pages, so it reuses the existing
  add-to-cart + cart-update wiring (assets/product-form.js) instead of new JS.
{% endcomment %}

{{ 'component-cart-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 and cart != empty -%}
  <div class="gradient color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    <div class="page-width container">
      <section class="wk-offers">
        <h2 class="wk-offers__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'product' and block.settings.product != null -%}
            {%- assign product = block.settings.product -%}
            {%- assign variant = product.selected_or_first_available_variant -%}
            <div class="wk-offer" {{ block.shopify_attributes }}>
              <a href="{{ product.url }}" class="wk-offer__media" tabindex="-1" aria-hidden="true">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media
                    | image_url: width: 264
                    | image_tag: loading: 'lazy', width: 132, height: 132
                  }}
                {%- endif -%}
              </a>
              <div>
                <a href="{{ product.url }}"><b>{{ block.settings.title | default: product.title }}</b></a>
                <p>{{ block.settings.text | default: product.description | strip_html | truncate: 110 }}</p>
              </div>
              <div class="wk-offer__cta">
                <span class="wk-offer__price">{{ variant.price | money }}</span>
                <product-form>
                  {%- form 'product',
                    product,
                    id: 'cart-cross-sell-' | append: block.id,
                    class: 'form',
                    novalidate: 'novalidate',
                    data-type: 'add-to-cart-form'
                  -%}
                    <input type="hidden" name="id" value="{{ variant.id }}" {% if variant.available == false or variant == null %}disabled{% endif %}>
                    <button
                      type="submit"
                      name="add"
                      class="wk-add"
                      {% if variant.available == false or variant == null %}disabled{% endif %}
                    >
                      <span>
                        {%- if variant == null or variant.available == false -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- else -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- endif -%}
                      </span>
                      {%- render 'loading-spinner' -%}
                    </button>
                  {%- endform -%}
                </product-form>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </section>
    </div>
  </div>

  <script src="{{ 'cart-cross-sell.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Cart cross-sell",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Additional offers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Frequently bought together."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "text", "label": "Description override" }
      ]
    }
  ]
}
{% endschema %}
